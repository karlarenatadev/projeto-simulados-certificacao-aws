# Google Generative AI (Gemini)
GOOGLE_API_KEY=seu_google_api_key_aqui

# Groq API (fallback para geração de questões)
GROQ_API_KEY=seu_groq_api_key_aqui

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aws_simulator
DB_USER=postgres
DB_PASSWORD=postgres

# PGlite (Database Configuration)
# DB_DATA_DIR is required outside NODE_ENV=test.
# - For tests: Must be set to "memory://" (or handled automatically).
# - For local dev/prod: Should be a persistent path, e.g., ".pglite-data"
# This directory is used by npm run db:seed and npm run api:start.
DB_DATA_DIR=.pglite-data
NODE_ENV=development

# FastAPI
API_HOST=localhost
API_PORT=8000

# Express API
PORT=3001

# Configurações opcionais
ENVIRONMENT=development
DEBUG=false
