# Google Generative AI (Gemini)
GOOGLE_API_KEY=seu_google_api_key_aqui

# Groq API (fallback para geração de questões)
GROQ_API_KEY=seu_groq_api_key_aqui

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aws_simulator
DB_USER=postgres
DB_PASSWORD=postgres

# PGlite (Database Configuration)
# DB_DATA_DIR is required outside NODE_ENV=test.
# - For tests: Must be set to "memory://" (or handled automatically).
# - For local dev/prod: Should be a persistent path, e.g., ".pglite-data"
# This directory is used by npm run db:seed and npm run api:start.
DB_DATA_DIR=.pglite-data
NODE_ENV=development

# FastAPI
API_HOST=localhost
API_PORT=8000

# Express API
PORT=3001
# Optional Express proxy IPs/CIDRs, comma-separated. Empty = do not trust proxies.
# Configure only after the hosting proxy topology is known; never use true or /0.
TRUST_PROXY=
# Public frontend API URL. Leave empty locally to use the browser hostname:3001.
# Static/production deployments need their real HTTPS backend URL (never loopback).
PUBLIC_API_BASE_URL=

# Google Identity Services (public OAuth client ID; configure in deployment)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
AUTH_ALLOWED_DOMAINS=a3data.com.br,a3data.com
# Email-only login is an explicit development/test opt-in, never production.
ALLOW_DEV_EMAIL_LOGIN=false

# HMAC secret used to sign backend sessions. Required outside tests.
# Production: at least 32 random bytes; the placeholder below is rejected.
AUTH_SESSION_SECRET=replace_with_a_long_random_secret

# Bootstrap privilegiado (emails separados por virgula; somente exemplos)
# Sem BOOTSTRAP_ADMIN_EMAILS, o seed nao cria nem promove Admins.
BOOTSTRAP_ADMIN_EMAILS=admin@example.com
BOOTSTRAP_VALIDATOR_EMAILS=validator@example.com

# Configurações opcionais
ENVIRONMENT=development
DEBUG=false
