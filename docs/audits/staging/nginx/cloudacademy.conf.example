# Install only after replacing the certificate, name and approved network include.
# The included geo map intentionally defaults to deny and is absent until the
# network owner supplies real approved VPN/proxy egress CIDRs.
geo $cloudacademy_corporate_access {
    default 0;
    include /etc/nginx/cloudacademy/approved-cidrs.map;
}

server {
    listen 80 default_server;
    server_name REPLACE_WITH_APPROVED_INTERNAL_HOSTNAME;
    if ($cloudacademy_corporate_access = 0) { return 403; }
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name REPLACE_WITH_APPROVED_INTERNAL_HOSTNAME;

    ssl_certificate     /etc/cloudacademy/tls/fullchain.pem;
    ssl_certificate_key /etc/cloudacademy/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 10m;

    if ($cloudacademy_corporate_access = 0) { return 403; }

    root /opt/cloudacademy/current/public;
    index index.html;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    client_max_body_size 10m;

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_buffering on;
    }

    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "private, no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
}
