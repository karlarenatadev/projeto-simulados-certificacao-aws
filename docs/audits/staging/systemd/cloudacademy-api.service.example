[Unit]
Description=CloudAcademy A3 Express API (PGlite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudacademy
Group=cloudacademy
WorkingDirectory=/opt/cloudacademy/current
Environment=NODE_ENV=staging
Environment=DB_ENGINE=pglite
Environment=DB_DATA_DIR=/var/lib/cloudacademy/pglite
Environment=PORT=3001
EnvironmentFile=/etc/cloudacademy/api.env
ExecStart=/usr/bin/node backend/api/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cloudacademy
ReadWritePaths=/var/log/cloudacademy
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryMax=3G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
